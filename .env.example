# ==============================================================================
# AI Hedge Finance (ahf) V2 — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
NODE_ENV=DEV                      # DEV | DOCKER
DEPLOY_ENV=DEV                    # DEV | STAGE | PRODUCTION
BOT_ID=                           # Unique UUID for this bot instance
BOT_VERSION=2.0.0-alpha.1
EXCH_MODE=                        # SIM | REAL
POD_DIR=                          # Path to trained model directory e.g. data/models/pod_000042
ENV_NAME=BrunhildEnv-v11          # RL gym environment name
AGENT_ID=0
INIT_TRADE_CASH=1000.0
TRADE_TIMEOUT=20
ORDER_FILL_STATUS_TIMEOUT=20
DEBUG=0
LOGLEVEL=INFO

# ------------------------------------------------------------------------------
# Signal Pipeline
# ------------------------------------------------------------------------------
PIPELINE_CONFIG=configs/pipeline.json   # Path to pipeline.json

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Binance Exchange
# ------------------------------------------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=

BINANCE_API_KEY_SIM=
BINANCE_API_SECRET_SIM=

BINANCE_API_KEY_BTC=
BINANCE_API_SECRET_BTC=

BINANCE_API_KEY_ETH=
BINANCE_API_SECRET_ETH=

BINANCE_API_KEY_TEST=
BINANCE_API_SECRET_TEST=

# Kraken (future)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ------------------------------------------------------------------------------
# LLM API Keys (for LLM signal producers)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=

# ------------------------------------------------------------------------------
# Email Notifications
# ------------------------------------------------------------------------------
SEND_MAIL=0
SEND_MAIL_RECEIVER=user@example.com
GOOGLE_SMTP=smtp.gmail.com
GOOGLE_MAIL_USER=user@example.com
GOOGLE_MAIL_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# Optuna Hyperparameter Tuning
# Default: SQLite (file-based, no server needed)
# Override for MySQL: optuna-mysql+pymysql://user:pass@host/db
# ------------------------------------------------------------------------------
OPTUNA_STORAGE=sqlite:///data/optuna.db
OPTUNA_STUDY_NAME=ahf_tune_v2
