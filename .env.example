# ==============================================================================
# AI Hedge Finance (AHF) v2 — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
NODE_ENV=DEV                      # DEV | DOCKER
DEPLOY_ENV=DEV                    # DEV | STAGE | PRODUCTION
BOT_ID=                           # Unique UUID for this bot instance
BOT_VERSION=2.0.0-alpha.1
EXCH_MODE=SIM                     # SIM | REAL
POD_DIR=                          # Path to trained model dir e.g. data/models/pod_000042
ENV_NAME=BrunhildEnv-v11          # RL gym environment name
AGENT_ID=0
INIT_TRADE_CASH=1000.0
TRADE_TIMEOUT=20
ORDER_FILL_STATUS_TIMEOUT=20
DEBUG=0
LOGLEVEL=INFO

# ------------------------------------------------------------------------------
# AHF Entrypoint Settings (ahf-trade, ahf-train, ahf-backtest)
# ------------------------------------------------------------------------------
TRADING_MODE=PAPER                # PAPER | LIVE | SIMULATION
SYMBOL=BTCUSDT
PIPELINE_CONFIG=configs/pipeline.json
INITIAL_CAPITAL=1000.0
BUY_THRESHOLD=0.1
SELL_THRESHOLD=-0.1
CONFIDENCE_FLOOR=0.0
MAX_DRAWDOWN_PCT=0.15
MAX_LOSS_PCT=0.30
KELLY_FRACTION=0.5
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=data/logs/signal_audit.jsonl

# RL Training
STRATEGY=double_kf
POD_ID=pod_000000

# ------------------------------------------------------------------------------
# Signal Pipeline
# ------------------------------------------------------------------------------
PIPELINE_CONFIG=configs/pipeline.json

# ------------------------------------------------------------------------------
# Redis (optional — for distributed coordination)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Binance Exchange
# ------------------------------------------------------------------------------
BINANCE_API_KEY=                  # Required for LIVE trading
BINANCE_API_SECRET=

BINANCE_API_KEY_SIM=              # Paper trading (simulated Binance testnet)
BINANCE_API_SECRET_SIM=

BINANCE_API_KEY_TEST=             # Binance testnet
BINANCE_API_SECRET_TEST=

# Future exchanges
# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=

# ------------------------------------------------------------------------------
# LLM API Keys (for LLMSignalProducer and MetaLLMAggregator)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=

# ------------------------------------------------------------------------------
# Email Notifications (optional, via Apprise)
# ------------------------------------------------------------------------------
SEND_MAIL=0
SEND_MAIL_RECEIVER=user@example.com
GOOGLE_SMTP=smtp.gmail.com
GOOGLE_MAIL_USER=user@example.com
GOOGLE_MAIL_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# Optuna Hyperparameter Tuning
# Default: SQLite (file-based, no server needed)
# For MySQL: optuna_storage=mysql+pymysql://user:pass@host/dbname
# ------------------------------------------------------------------------------
OPTUNA_STORAGE=sqlite:///data/optuna.db
OPTUNA_STUDY_NAME=ahf_tune_v2
